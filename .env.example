# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "ollama" | "openai" | "gemini"
LLM_PROVIDER=ollama

# ─── Ollama Settings ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ─── OpenAI Settings (optional) ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ─── Google Gemini Settings (optional) ────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# ─── LLM Generation ───────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ─── Embedding Model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=pdf_rag_store

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=5
CONFIDENCE_THRESHOLD=0.40
RERANK_ENABLED=true
HYBRID_SEARCH_ALPHA=0.7

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_SESSION=20

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_SIZE=256
CACHE_TTL_SECONDS=3600
